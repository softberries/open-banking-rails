      "rule_field": {
        "required": "false",
        "type": "String",
        "values": "[\"title\", \"counterparty_name\", \"counterparty_iban\"]",
        "desc": "Required when mode=create_rule"
      },
      "rule_kind": {
        "required": "false",
        "type": "String",
        "values": "[\"contains\", \"equals\", \"regex\", \"starts_with\", \"ends_with\"]"
      },

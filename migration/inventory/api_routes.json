    "method": "GET",
    "path": "/api/:version/transactions(.json)",
    "version": "v1",
    "description": "List ledger entries (bank + manual) with filters and pagination",
    "params": {
      "from": {
        "required": "false",
        "type": "Date",
        "desc": "Booking date >= (ISO 8601)"
      },
      "to": {
        "required": "false",
        "type": "Date",
        "desc": "Booking date <= (ISO 8601)"
      },
      "direction": {
        "required": "false",
        "type": "String",
        "values": "[\"credit\", \"debit\"]"
      },
      "status": {
        "required": "false",
        "type": "String",
        "values": "[\"booked\", \"pending\"]"
      },
      "account_id": {
        "required": "false",
        "type": "Integer"
      },
      "merchant_id": {
        "required": "false",
        "type": "Integer"
      },
      "category_id": {
        "required": "false",
        "type": "Integer"
      },
      "category_path": {
        "required": "false",
        "type": "String",
        "desc": "ltree prefix; matches descendants"
      },
      "payment_method": {
        "required": "false",
        "type": "String"
      },
      "currency": {
        "required": "false",
        "type": "String"
      },
      "source_type": {
        "required": "false",
        "type": "String",
        "values": "[\"BankTransaction\", \"ManualTransaction\"]"
      },
      "page": {
        "required": "false",
        "type": "Integer"
      },
      "limit": {
        "required": "false",
        "type": "Integer"
      }
    },
    "namespace": "/transactions",
    "settings_auth": null
  },

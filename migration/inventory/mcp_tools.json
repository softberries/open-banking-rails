            "create_rule"
          ]
        },
        "merchant_id": {
          "type": "integer"
        },
        "category_id": {
          "type": "integer"
        },
        "rule_field": {
          "type": "string",
          "enum": [
            "title",
            "counterparty_name",
            "counterparty_iban"
          ]
        },
        "rule_kind": {
          "type": "string",
          "enum": [
            "contains",
            "equals",
            "regex",
            "starts_with",
            "ends_with"
          ]
        },
        "rule_pattern": {
          "type": "string"
        }
      },

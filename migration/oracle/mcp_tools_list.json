{
  "tools": [
    {
      "name": "cash.create_transaction",
      "description": "Record a manual cash transaction (income or expense) for the current user.",
      "inputSchema": {
        "properties": {
          "amount": {
            "type": "string",
            "description": "Decimal amount, e.g. '12.50'"
          },
          "currency": {
            "type": "string",
            "description": "ISO-4217, defaults to PLN"
          },
          "direction": {
            "type": "string",
            "enum": [
              "debit",
              "credit"
            ],
            "description": "Defaults to debit (expense)"
          },
          "booking_date": {
            "type": "string",
            "format": "date"
          },
          "transaction_date": {
            "type": "string",
            "format": "date"
          },
          "title": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "counterparty_name": {
            "type": "string"
          },
          "merchant_id": {
            "type": "integer"
          },
          "category_id": {
            "type": "integer"
          },
          "payment_method": {
            "type": "string",
            "description": "cash / card / blik_p2p / transfer / other"
          }
        },
        "required": [
          "amount"
        ],
        "type": "object"
      }
    },
    {
      "name": "cash.update_transaction",
      "description": "Update fields on an existing manual cash transaction. Currency is locked - delete and recreate to change it.",
      "inputSchema": {
        "properties": {
          "id": {
            "type": "integer"
          },
          "amount": {
            "type": "string",
            "description": "Decimal, e.g. '12.50'. Omit to keep"
          },
          "direction": {
            "type": "string",
            "enum": [
              "debit",
              "credit"
            ]
          },
          "booking_date": {
            "type": "string",
            "format": "date"
          },
          "transaction_date": {
            "type": "string",
            "format": "date"
          },
          "title": {
            "type": "string",
            "description": "Empty string clears"
          },
          "note": {
            "type": "string",
            "description": "Empty string clears"
          },
          "counterparty_name": {
            "type": "string",
            "description": "Empty string clears"
          },
          "merchant_id": {
            "type": "integer"
          },
          "category_id": {
            "type": "integer"
          },
          "payment_method": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      }
    },
    {
      "name": "cash.delete_transaction",
      "description": "Delete a manual cash transaction. Auto-generated rows (e.g. ATM linker) cannot be deleted here.",
      "inputSchema": {
        "properties": {
          "id": {
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      }
    },
    {
      "name": "transactions.list",
      "description": "List ledger entries (bank + manual) with filters. Returns at most `limit` rows (default 25, max 200).",
      "inputSchema": {
        "properties": {
          "from": {
            "type": "string",
            "format": "date",
            "description": "Booking date >="
          },
          "to": {
            "type": "string",
            "format": "date",
            "description": "Booking date <="
          },
          "direction": {
            "type": "string",
            "enum": [
              "credit",
              "debit"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "booked",
              "pending"
            ]
          },
          "account_id": {
            "type": "integer"
          },
          "merchant_id": {
            "type": "integer"
          },
          "category_id": {
            "type": "integer"
          },
          "category_path": {
            "type": "string",
            "description": "ltree prefix; matches descendants"
          },
          "payment_method": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "BankTransaction",
              "ManualTransaction"
            ]
          },
          "limit": {
            "type": "integer",
            "description": "1-200, default 25"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "transactions.get",
      "description": "Fetch a single ledger entry by source type + id.",
      "inputSchema": {
        "properties": {
          "source_type": {
            "type": "string",
            "enum": [
              "BankTransaction",
              "ManualTransaction"
            ]
          },
          "source_id": {
            "type": "integer"
          }
        },
        "required": [
          "source_type",
          "source_id"
        ],
        "type": "object"
      }
    },
    {
      "name": "transactions.classify",
      "description": "Apply a merchant + category to a bank transaction.\nmode=only_this writes the override on this row only.\nmode=all_for_merchant sets merchant.default_category - all rows for the merchant inherit.\nmode=create_rule creates a user-source MerchantRule (rule_field/rule_kind/rule_pattern required) and rebuilds enrichment.",
      "inputSchema": {
        "properties": {
          "bank_transaction_id": {
            "type": "integer"
          },
          "mode": {
            "type": "string",
            "enum": [
              "only_this",
              "all_for_merchant",
              "create_rule"
            ]
          },
          "merchant_id": {
            "type": "integer"
          },
          "category_id": {
            "type": "integer"
          },
          "rule_field": {
            "type": "string",
            "enum": [
              "title",
              "counterparty_name",
              "counterparty_iban"
            ]
          },
          "rule_kind": {
            "type": "string",
            "enum": [
              "contains",
              "equals",
              "regex",
              "starts_with",
              "ends_with"
            ]
          },
          "rule_pattern": {
            "type": "string"
          }
        },
        "required": [
          "bank_transaction_id",
          "mode"
        ],
        "type": "object"
      }
    },
    {
      "name": "categories.list",
      "description": "List the user's categories. Hierarchy is encoded in `path` (ltree dot-separated).",
      "inputSchema": {
        "properties": {
          "include_archived": {
            "type": "boolean",
            "description": "Default false"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "categories.create",
      "description": "Create a new category. parent_path is the ltree path of the parent ('food.cooking' etc.); omit for top-level.",
      "inputSchema": {
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "description": "Auto-generated when omitted"
          },
          "kind": {
            "type": "string",
            "enum": [
              "expense",
              "income",
              "transfer",
              "savings",
              "ignored"
            ]
          },
          "color": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          },
          "essential": {
            "type": "boolean"
          },
          "parent_path": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      }
    },
    {
      "name": "categories.update",
      "description": "Update / move a category. Changing parent_path rewrites paths of all descendants atomically.",
      "inputSchema": {
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "expense",
              "income",
              "transfer",
              "savings",
              "ignored"
            ]
          },
          "color": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          },
          "essential": {
            "type": "boolean"
          },
          "parent_path": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      }
    },
    {
      "name": "categories.archive",
      "description": "Archive a category - kept in storage but hidden from active lists.",
      "inputSchema": {
        "properties": {
          "id": {
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      }
    },
    {
      "name": "categories.unarchive",
      "description": "Restore a previously archived category.",
      "inputSchema": {
        "properties": {
          "id": {
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      }
    },
    {
      "name": "merchants.list",
      "description": "List the user's merchants. Default: active only, name ASC, max 100 rows.",
      "inputSchema": {
        "properties": {
          "q": {
            "type": "string",
            "description": "Name ILIKE %q%"
          },
          "source": {
            "type": "string",
            "enum": [
              "user",
              "llm",
              "seed",
              "system"
            ]
          },
          "category_id": {
            "type": "integer"
          },
          "include_archived": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "description": "1-200, default 50"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "merchants.create",
      "description": "Create a user-source merchant. Slug auto-generated when omitted.",
      "inputSchema": {
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "company",
              "person",
              "unknown"
            ]
          },
          "default_category_id": {
            "type": "integer"
          },
          "logo_url": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      }
    },
    {
      "name": "merchants.update",
      "description": "Update editable fields of a merchant.",
      "inputSchema": {
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "company",
